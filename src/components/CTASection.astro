---
import { cta } from '../content/landing';
import { NewsletterForm } from './islands/NewsletterForm';
---

<section class="section cta" id="CTA">
  <div class="container container-flex-center">
    <div class="cta-wrapper">
      <div class="cta-wrapper-flex">
        <h2 class="reveal">{cta.title}</h2>
        <div class="cta-text-center">
          <div class="text-s reveal">{cta.body}</div>
        </div>
      </div>
      <NewsletterForm client:visible />
    </div>
  </div>
</section>

<style>
  .section.cta {
    background-image:
      linear-gradient(to bottom, var(--black-light-50), var(--black-light-50)),
      url('/images/686fae0a49f3d6062a09c27f_cta.webp');
    background-position: 0 0, 50% 100%;
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
    min-height: 50rem;
    display: flex;
    align-items: center;
    color: var(--white);
  }

  @media (hover: hover) and (pointer: fine) {
    .section.cta {
      background-attachment: scroll, fixed;
    }
  }

  .container-flex-center {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .cta-wrapper {
    max-width: 48rem;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3.75rem;
  }

  .cta-wrapper-flex {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
