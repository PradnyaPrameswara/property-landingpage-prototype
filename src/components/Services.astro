---
import { servicesIntro, services } from '../content/landing';
---

<section class="section section-long-bottom-pading" id="services">
  <div class="container">
    <div class="autotabs-wrapper">
      <h2 class="reveal">{servicesIntro.title}</h2>
      <div class="autotabs-container" data-autotabs>
        <div class="relative">
          <ul class="autotabs" data-tabs>
            {
              services.map((service) => (
                <li class="autotabs-item">
                  <a
                    class="autotabs-tab reveal"
                    href={service.href}
                    data-tab={service.slug}
                    data-active="false"
                  >
                    <span class="services-heder-wrapper">
                      <span class="heading-m">{service.title}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="services-stage">
            <div class="service-panel generic-panel active" data-panel="__generic" aria-hidden="false">
              <span class="services-heropage-wrapper">
                <img
                  class="servises-image"
                  src="/images/686d2dba14196e5ea16f8594_serv.webp"
                  alt="interior design"
                  width="960"
                  loading="eager"
                />
              </span>
              <p class="text-s service-desc">{servicesIntro.body}</p>
            </div>
            {
              services.map((service, i) => (
                <a
                  class="service-panel"
                  href={service.href}
                  data-panel={service.slug}
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <span class="services-heropage-wrapper">
                    <img
                      class="servises-image"
                      src={service.image}
                      alt=""
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  </span>
                  <span class="text-s service-desc">{service.excerpt}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-autotabs]');
  const tabs = Array.from(root?.querySelectorAll('[data-tab]') ?? []);
  const panels = Array.from(root?.querySelectorAll('[data-panel]') ?? []);
  const list = root?.querySelector('[data-tabs]');

  function activate(slug: string | null) {
    tabs.forEach((tab) => {
      const on = slug !== null && tab.getAttribute('data-tab') === slug;
      tab.classList.toggle('current', on);
      tab.setAttribute('data-active', String(on));
    });
    panels.forEach((panel) => {
      const on = (slug ?? '__generic') === panel.getAttribute('data-panel');
      panel.classList.toggle('active', on);
      panel.setAttribute('aria-hidden', String(!on));
      if (panel.hasAttribute('href')) {
        if (on) {
          panel.removeAttribute('tabindex');
        } else {
          panel.setAttribute('tabindex', '-1');
        }
      }
    });
  }

  tabs.forEach((tab) => {
    const slug = tab.getAttribute('data-tab') ?? '';
    tab.addEventListener('focus', () => activate(slug));
  });

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    tabs.forEach((tab) => {
      const slug = tab.getAttribute('data-tab') ?? '';
      tab.addEventListener('mouseenter', () => activate(slug));
    });
    list?.addEventListener('mouseleave', () => activate(null));
  }
</script>

<style>
  .autotabs-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .autotabs-container {
    display: flex;
    flex-direction: column;
    gap: 3.75rem;
  }

  .relative {
    position: relative;
  }

  .autotabs {
    display: block;
    list-style: none;
    width: 50%;
    margin: 0 0 0 auto;
    padding: 0;
    min-width: 0;
  }

  .autotabs-item {
    margin: 0;
    padding: 0;
  }

  .autotabs-tab {
    color: #0d0b0b;
    text-decoration: none;
    display: flex;
    width: 100%;
    min-height: 44px;
    padding: 2.81rem 0 2.81rem 2rem;
    border-top: 1px solid var(--gray-100);
    transition:
      color 0.35s ease-out,
      background-color 0.35s ease-out;
  }

  .autotabs-item:last-child .autotabs-tab {
    border-bottom: 1px solid var(--gray-100);
  }

  .autotabs-tab.current {
    color: #fff;
    background: var(--accent);
  }

  .autotabs-tab.current:focus-visible {
    outline-color: #fff;
  }

  .services-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: min(35.5rem, 49%);
    height: 100%;
  }

  .service-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.3s ease-out,
      visibility 0s linear 0.3s;
  }

  .service-panel.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s ease-out,
      visibility 0s linear 0s;
  }

  .services-heropage-wrapper {
    width: min(31.75rem, 100%);
    aspect-ratio: 508 / 360;
    overflow: hidden;
  }

  .generic-panel .service-desc {
    max-width: 32rem;
  }

  .servises-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }

  .service-desc {
    margin: 0;
    max-width: 32rem;
  }

  @media (max-width: 991px) {
    .autotabs-wrapper {
      gap: 2rem;
    }

    .autotabs-container {
      gap: 2rem;
    }
  }

  @media (max-width: 767px) {
    .relative {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .autotabs {
      width: 100%;
      margin: 0;
      order: 2;
    }

    .services-stage {
      position: relative;
      order: 1;
      width: 100%;
      height: auto;
      display: grid;
    }

    .service-panel {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
    }

    .services-heropage-wrapper {
      width: 100%;
    }

    .autotabs-tab {
      padding: 1.5rem 0 1.5rem 1.5rem;
    }
  }

  @media (max-width: 479px) {
    .autotabs-wrapper {
      gap: 1.5rem;
    }

    .autotabs-container {
      gap: 1.5rem;
    }

    .service-panel {
      gap: 1.25rem;
    }

    .autotabs-tab {
      padding: 1.25rem 0 1.25rem 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-panel,
    .autotabs-tab {
      transition: none;
    }
  }
</style>
