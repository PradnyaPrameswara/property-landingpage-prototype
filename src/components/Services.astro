---
import { servicesIntro, services } from '../content/landing';
---

<section class="section section-long-bottom-pading" id="services">
  <div class="container">
    <div class="autotabs-wrapper">
      <div class="autotabs-container" data-autotabs>
        <h2 class="reveal">{servicesIntro.title}</h2>
        <div class="relative">
          <ul class="autotabs" data-tabs>
            {
              services.map((service) => (
                <li class="autotabs-item">
                  <a
                    class="autotabs-tab reveal"
                    href={service.href}
                    data-tab={service.slug}
                    data-active="false"
                  >
                    <span class="services-heder-wrapper">
                      <span class="heading-m">{service.title}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <div class="services-stage">
            <div class="service-panel generic-panel active" data-panel="__generic" aria-hidden="false">
              <span class="services-heropage-wrapper">
                <img
                  class="servises-image"
                  src="/images/686d2dba14196e5ea16f8594_serv.webp"
                  alt="interior design"
                  width="960"
                  loading="eager"
                />
              </span>
              <p class="text-s service-desc">{servicesIntro.body}</p>
            </div>
            {
              services.map((service, i) => (
                <a
                  class="service-panel"
                  href={service.href}
                  data-panel={service.slug}
                  aria-hidden="true"
                  tabindex="-1"
                >
                  <span class="services-heropage-wrapper">
                    <img
                      class="servises-image"
                      src={service.image}
                      alt=""
                      loading={i === 0 ? 'eager' : 'lazy'}
                    />
                  </span>
                  <span class="text-s service-desc">{service.excerpt}</span>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-autotabs]');
  const tabs = Array.from(root?.querySelectorAll('[data-tab]') ?? []);
  const panels = Array.from(root?.querySelectorAll('[data-panel]') ?? []);
  const list = root?.querySelector('[data-tabs]');

  function activate(slug: string | null) {
    tabs.forEach((tab) => {
      const on = slug !== null && tab.getAttribute('data-tab') === slug;
      tab.classList.toggle('current', on);
      tab.setAttribute('data-active', String(on));
    });
    panels.forEach((panel) => {
      const on = (slug ?? '__generic') === panel.getAttribute('data-panel');
      panel.classList.toggle('active', on);
      panel.setAttribute('aria-hidden', String(!on));
      if (panel.hasAttribute('href')) {
        if (on) {
          panel.removeAttribute('tabindex');
        } else {
          panel.setAttribute('tabindex', '-1');
        }
      }
    });
  }

  tabs.forEach((tab) => {
    const slug = tab.getAttribute('data-tab') ?? '';
    tab.addEventListener('focus', () => activate(slug));
  });

  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    tabs.forEach((tab) => {
      const slug = tab.getAttribute('data-tab') ?? '';
      tab.addEventListener('mouseenter', () => activate(slug));
    });
    list?.addEventListener('mouseleave', () => activate(null));
  }
</script>

<style>
  .autotabs-wrapper {
    display: block;
  }

  .autotabs-container {
    display: flex;
    flex-direction: column;
    gap: 3.75rem;
  }

  .relative {
    position: relative;
  }

  .autotabs {
    display: flex;
    flex-direction: column;
    list-style: none;
    width: 100%;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  .autotabs-item {
    margin: 0 0 0 auto;
    padding: 0;
    width: 50%;
    border-top: 1px solid var(--gray-100);
  }

  .autotabs-tab {
    color: var(--black);
    text-decoration: none;
    display: flex;
    align-items: center;
    width: 100%;
    height: 8.09375rem;
    padding: 0 0 0 2rem;
    transition:
      color 0.35s ease-out,
      background-color 0.35s ease-out;
  }

  .autotabs-tab.current {
    color: var(--white);
    background: var(--accent);
  }

  .autotabs-tab.current:focus-visible {
    outline-color: var(--white);
  }

  .services-stage {
    position: absolute;
    left: 0;
    top: 0;
    width: min(31.9rem, 49%);
    height: 100%;
  }

  .service-panel {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    color: inherit;
    text-decoration: none;
    transition:
      opacity 0.3s ease-out,
      visibility 0s linear 0.3s;
  }

  .service-panel.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition:
      opacity 0.3s ease-out,
      visibility 0s linear 0s;
  }

  .services-heropage-wrapper {
    width: min(31.75rem, 100%);
    height: 22.5rem;
    overflow: hidden;
  }

  .generic-panel .service-desc {
    max-width: 32rem;
  }

  .servises-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    display: block;
  }

  .service-desc {
    margin: 0;
    max-width: 32rem;
  }

  @media (max-width: 991px) {
    .section#services {
      padding-top: 5rem;
    }

    .section#services .container {
      padding-inline: 1.25rem;
    }

    .services-stage {
      width: 42%;
    }
  }

  @media (max-width: 767px) {
    .autotabs {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .autotabs-item {
      width: 100%;
      margin: 0;
    }

    .autotabs-tab {
      height: 7.54375rem;
      padding-left: 0.75rem;
    }

    .services-stage {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-panel,
    .autotabs-tab {
      transition: none;
    }
  }
</style>
