---
import { projectsIntro, projects } from '../content/landing';
---

<section class="section section-long-padding" data-cursor-area>
  <div class="container">
    <div class="projects-content">
      <h2 class="reveal">{projectsIntro.title}</h2>
      <div class="projects-content-cards">
        <div class="cursor-view" data-cursor aria-hidden="true">View</div>
        <div class="progects-list-wrapper">
          <div class="projects-list">
            {
              projects.map((project) => (
                <div class="projects-item reveal">
                  <a class="project-card" href={project.href} aria-label={project.title}>
                    <span class="projects-image-wrapper">
                      <img class="image-full-width" src={project.image} alt="" loading="lazy" />
                    </span>
                    <span class="projects-text-wrapper">
                      <span class="heading-s">{project.title}</span>
                      <span class="grey-content">
                        <span class="text-s">{project.excerpt}</span>
                      </span>
                    </span>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
        <div class="button-wrapper-center reveal">
          <a class="button-white" href={projectsIntro.ctaHref} aria-label="button">
            <span class="swap">
              <span>{projectsIntro.ctaLabel}</span>
              <span aria-hidden="true">{projectsIntro.ctaLabel}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .image-full-width {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .projects-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .button-wrapper-center {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 991px) {
    .projects-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .projects-list {
      grid-template-columns: 1fr;
    }
  }
</style>
