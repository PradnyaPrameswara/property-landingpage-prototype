---
import { projectsIntro, projects } from '../content/landing';
---

<section class="section section-long-padding" data-cursor-area>
  <div class="container">
    <div class="projects-content">
      <h2 class="reveal">{projectsIntro.title}</h2>
      <div class="projects-content-cards">
        <div class="cursor-view" data-cursor aria-hidden="true">View</div>
        <div class="progects-list-wrapper">
          <div class="projects-list" role="region" tabindex="0" aria-label="Featured projects, scroll horizontally to see more">
            {
              projects.map((project) => (
                <div class="projects-item reveal">
                  <a class="project-card" href={project.href} aria-label={project.title}>
                    <span class="projects-image-wrapper">
                      <img class="image-full-width" src={project.image} alt="" loading="lazy" />
                    </span>
                    <span class="projects-text-wrapper">
                      <span class="heading-s">{project.title}</span>
                      <span class="grey-content">
                        <span class="text-s">{project.excerpt}</span>
                      </span>
                    </span>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
        <div class="button-wrapper-center reveal">
          <a class="button-white" href={projectsIntro.ctaHref} aria-label="button">
            <span class="swap">
              <span>{projectsIntro.ctaLabel}</span>
              <span aria-hidden="true">{projectsIntro.ctaLabel}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  section[data-cursor-area] {
    background: var(--gray-50);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .projects-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .project-card {
    background: var(--white);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .image-full-width {
    width: 100%;
    aspect-ratio: 376 / 448;
    object-fit: cover;
  }

  .projects-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 2rem;
  }

  .button-wrapper-center {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  @media (max-width: 991px) {
    .projects-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .projects-list {
      display: flex;
      grid-template-columns: none;
      gap: 1rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 0;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .projects-list::-webkit-scrollbar {
      display: none;
    }

    .projects-item {
      flex: 0 0 min(78%, 22rem);
      scroll-snap-align: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .projects-list {
      scroll-behavior: auto;
    }
  }
</style>
