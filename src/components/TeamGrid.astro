---
import { teamIntro, team } from '../content/landing';
---

<section class="section section-long-bottom-pading no-top-mobile-padding">
  <div class="container-inner container">
    <div class="content-vertical-align-center">
      <div class="teams-content">
        <h2 class="reveal">{teamIntro.title}</h2>
        <div class="teams-grid-collection">
          <div class="teams-rail">
            {
              team.map((member) => (
                <div class="teams-item reveal">
                  <a class="teams-card" href={member.href} aria-label="teams card">
                    <span class="teams-image-wrapper">
                      <img
                        class="image-inner"
                        src={member.image}
                        srcset={member.srcset}
                        sizes={member.sizes}
                        alt={member.name}
                        loading="eager"
                      />
                    </span>
                    <span class="teams-text-button-wrapper">
                      <span class="teams-text-wrapper">
                        <span class="heading-s">{member.name}</span>
                        <span class="grey-content">
                          <span class="text-s">{member.role}</span>
                        </span>
                      </span>
                      <span class="round-button">
                        <span class="arrow" aria-hidden="true">
                          <svg width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path
                              d="M1.5 11L6.5 6L1.5 1"
                              stroke="currentColor"
                              stroke-width="1.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        </span>
                      </span>
                    </span>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .teams-content {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .teams-rail {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1.5rem;
  }

  .teams-card {
    background: var(--white);
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .image-inner {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .teams-text-button-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .teams-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  @media (max-width: 991px) {
    .teams-rail {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .teams-rail {
      grid-template-columns: 1fr;
    }
  }
</style>
