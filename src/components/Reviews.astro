---
import { reviewsIntro, reviewsListA, reviewsListB, reviewStars } from '../content/landing';
---

<section class="section reviews">
  <div class="container container-relative">
    <div class="content-grid mobile-flex">
      <div class="div-block-10">
        <div class="column-left">
          <h2 class="reveal">{reviewsIntro.title}</h2>
          <div class="text-s reveal">{reviewsIntro.body}</div>
        </div>
      </div>
      <div class="column-right">
        <div class="reviews-list-wrapper">
          <div class="reviews-list">
            {
              reviewsListA.map((review) => (
                <div class="collection-item-2 reveal">
                  <a class="column-grid" href={review.href} aria-label={`Review by ${review.author}`}>
                    <div class="review-card">
                      <div>
                        <img src={reviewStars} alt="" loading="lazy" />
                      </div>
                      <div class="grey-content">
                        <div class="text-s">{review.quote}</div>
                      </div>
                      <div class="text-s">{review.author}</div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
        <div class="reviews-list-wrapper right-mobile-hidden">
          <div class="reviews-list">
            {
              reviewsListB.map((review) => (
                <div class="collection-item-2 reveal">
                  <a class="column-grid" href={review.href} aria-label={`Review by ${review.author}`}>
                    <div class="review-card">
                      <div>
                        <img src={reviewStars} alt="" loading="lazy" />
                      </div>
                      <div class="grey-content">
                        <div class="text-s">{review.quote}</div>
                      </div>
                      <div class="text-s">{review.author}</div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section.reviews {
    background-image:
      linear-gradient(to bottom, var(--black-light-50), var(--black-light-50)),
      url('/images/6876462e38be354c9648481c_0001111.webp');
    background-position: 0 0, 50%;
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
    min-height: 50rem;
    padding-top: 7.5rem;
    padding-bottom: 7.5rem;
    color: var(--white);
  }

  @media (hover: hover) and (pointer: fine) {
    .section.reviews {
      background-attachment: scroll, fixed;
    }
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    align-items: start;
  }

  .column-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 530px;
  }

  .column-right {
    display: grid;
    grid-template-columns: 278px 278px;
    gap: 1rem;
    align-items: start;
    justify-content: end;
  }

  .reviews-list {
    display: grid;
    grid-template-columns: 278px;
    gap: 1.25rem;
  }

  .review-card {
    background: var(--white);
    width: 18rem;
    max-width: 100%;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .column-grid {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 991px) {
    .column-left {
      grid-column: 1 / -1;
      max-width: none;
    }

    .column-right {
      grid-column: 1 / -1;
      justify-content: start;
    }

    .right-mobile-hidden {
      display: none;
    }
  }

  @media (max-width: 479px) {
    .column-right {
      grid-template-columns: 1fr;
    }
  }
</style>
