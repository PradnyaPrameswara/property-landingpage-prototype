---
import { reviewsIntro, reviewsListA, reviewsListB, reviewStars } from '../content/landing';
---

<section class="section reviews">
  <div class="container container-relative">
    <div class="content-grid mobile-flex">
      <div class="div-block-10">
        <div class="column-left">
          <h2 class="reveal">{reviewsIntro.title}</h2>
          <div class="text-s reveal">{reviewsIntro.body}</div>
        </div>
      </div>
      <div class="column-right">
        <div class="reviews-list-wrapper">
          <div class="reviews-list">
            {
              reviewsListA.map((review) => (
                <div class="collection-item-2 reveal">
                  <a class="column-grid" href={review.href} aria-label={`Review by ${review.author}`}>
                    <div class="review-card">
                      <div>
                        <img src={reviewStars} alt="" loading="lazy" />
                      </div>
                      <div class="grey-content">
                        <div class="text-s">{review.quote}</div>
                      </div>
                      <div class="text-s">{review.author}</div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
        <div class="reviews-list-wrapper right-mobile-hidden">
          <div class="reviews-list">
            {
              reviewsListB.map((review) => (
                <div class="collection-item-2 reveal">
                  <a class="column-grid" href={review.href} aria-label={`Review by ${review.author}`}>
                    <div class="review-card">
                      <div>
                        <img src={reviewStars} alt="" loading="lazy" />
                      </div>
                      <div class="grey-content">
                        <div class="text-s">{review.quote}</div>
                      </div>
                      <div class="text-s">{review.author}</div>
                    </div>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .section.reviews {
    background: var(--gray-50);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  .column-left {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: sticky;
    top: 6rem;
  }

  .column-right {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  .reviews-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .review-card {
    background: var(--white);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .column-grid {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 767px) {
    .content-grid.mobile-flex {
      grid-template-columns: 1fr;
    }

    .column-left {
      position: static;
    }

    .column-right {
      grid-template-columns: 1fr;
    }

    .right-mobile-hidden {
      display: none;
    }
  }
</style>
