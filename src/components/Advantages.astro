---
import { advantagesIntro, advantages } from '../content/landing';
---

<section class="section advantages">
  <div class="container">
    <div class="content-grid mobile-flex">
      <div class="column-sticky">
        <div class="column-left gap-40">
          <h2 class="reveal">{advantagesIntro.title}</h2>
          <div class="max-width-text-wrapper reveal">
            <div class="text-s">{advantagesIntro.body}</div>
          </div>
        </div>
      </div>
      <div class="column-right column-right-flex">
        {
          advantages.map((item) => (
            <div class="column-card-advant column-card-advant-white reveal">
              <div class="column-card-advant-top">
                <div class="circle-grey">
                  <div class="text-numbers">{item.number}</div>
                </div>
                <div class="column-card-advant-header">
                  {item.headingLevel === 'm' ? (
                    <div class="heading-m">{item.title}</div>
                  ) : (
                    <div class="heading-s">{item.title}</div>
                  )}
                </div>
              </div>
              <div class="column-card-advant-bottom">
                <div class="text-s">{item.body}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .section.advantages {
    background-image:
      linear-gradient(to bottom, var(--black-light-50), var(--black-light-50)),
      url('/images/6876391540ae940b8926594d_red place.webp');
    background-position: 0 0, 50%;
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
    padding-top: 7.5rem;
    padding-bottom: 7.5rem;
    color: var(--white);
    font-family: var(--font-display);
  }

  .max-width-text-wrapper {
    width: 100%;
    max-width: 28.68625rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .section.advantages {
      background-attachment: scroll, fixed;
    }
  }

  .content-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .column-sticky {
    position: sticky;
    top: 6rem;
    min-width: 0;
  }

  .column-left {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 33.13rem;
  }

  .column-right-flex {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    width: min(100%, 26.25rem);
    justify-self: center;
  }

  .column-card-advant-white {
    background: var(--gray-50);
    color: var(--black);
    padding: 2rem;
    width: 100%;
    height: 21rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .column-card-advant-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2.5rem;
  }

  .column-card-advant-header {
    width: 100%;
  }

  .circle-grey {
    flex: none;
    width: 3.875rem;
    height: 3.875rem;
    border-radius: 100%;
    background: var(--gray-200);
    display: grid;
    place-items: center;
    padding-top: 3px;
  }

  @media (max-width: 991px) {
    .section.advantages {
      padding-block: 5rem;
    }

    .section.advantages .container {
      padding-inline: 1.25rem;
    }

    .content-grid.mobile-flex {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .column-sticky {
      position: static;
      width: 100%;
    }

    .column-right-flex {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }

    .column-card-advant-white {
      height: 25rem;
    }
  }

  @media (max-width: 767px) {
    .column-right-flex {
      grid-template-columns: minmax(0, 1fr);
    }

    .column-card-advant-white {
      height: auto;
      min-height: 0;
    }
  }
</style>
