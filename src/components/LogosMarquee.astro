---
import { logos } from '../content/landing';
---

<section class="section no-bottom-mobile-padding" aria-label="Client logos">
  <div class="logos-wrapper marquee">
    <div class="logos-relative-wrapper">
      <div class="logos-wrapper-three">
        <div class="marquee-track">
          {
            logos.map((logo) => (
              <div class="logo-item">
                <div class="logo-row-wrapper">
                  <div class="logo-wrapper">
                    <img class="logo-image" src={logo.image} alt={`${logo.name} logo`} loading="eager" />
                  </div>
                </div>
              </div>
            ))
          }
          {
            logos.map((logo) => (
              <div class="logo-item" aria-hidden="true">
                <div class="logo-row-wrapper">
                  <div class="logo-wrapper">
                    <img class="logo-image" src={logo.image} alt="" loading="eager" />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .logo-item {
    flex: none;
  }

  .logo-image {
    height: 2.5rem;
    width: auto;
    object-fit: contain;
  }
</style>
