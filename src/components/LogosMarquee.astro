---
import { logos } from '../content/landing';
---

<section class="section no-bottom-mobile-padding" aria-label="Client logos">
  <div class="logos-wrapper marquee">
    <div class="logos-relative-wrapper">
      <div class="logos-wrapper-three">
        <div class="marquee-track">
          {
            [0, 1, 2, 3].map((copy) => (
              <div class="logos-list" aria-hidden={copy > 0 ? 'true' : undefined}>
                {
                  logos.map((logo) => (
                    <div class="logo-item">
                      <div class="logo-row-wrapper">
                        <div class="logo-wrapper">
                          <img
                            class="logo-image"
                            src={logo.image}
                            alt={copy === 0 ? `${logo.name} logo` : ''}
                            loading="eager"
                          />
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .marquee-track {
    gap: 0;
  }

  .logos-list {
    display: flex;
    flex: none;
    align-items: center;
    gap: 3rem;
    padding-right: 3rem;
  }

  .logo-item {
    flex: none;
  }

  .logo-image {
    height: 2.5rem;
    width: auto;
    object-fit: contain;
  }
</style>
