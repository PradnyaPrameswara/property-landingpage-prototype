---
import { navLinks } from '../content/landing';

type Props = {
  variant?: 'dark' | 'light';
};

const { variant = 'dark' } = Astro.props;
const contactClass = variant === 'light' ? 'button-white desktop-only' : 'button-transparent desktop-only';
---

<div class={`site-header header-${variant}`}>
  <div class="container header-inner">
