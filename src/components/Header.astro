272 74.1227 18.8272C75.3154 18.8272 76.3828 18.529 77.3247 17.9326C78.2735 17.3295 79.0189 16.4485 79.5611 15.2897C80.11 14.1241 80.3845 12.6942 80.3845 11Z" fill="currentColor" /><path d="M84.5486 21.4091V0.590899H91.9692C93.582 0.590899 94.9204 0.868746 95.9844 1.42444C97.0551 1.98014 97.8548 2.7493 98.3834 3.73193C98.912 4.70778 99.1763 5.83611 99.1763 7.11692C99.1763 8.39095 98.9086 9.51251 98.3732 10.4816C97.8446 11.4439 97.045 12.1927 95.9742 12.7281C94.9103 13.2635 93.5719 13.5311 91.959 13.5311H86.3377V10.8272H91.6744C92.6909 10.8272 93.5177 10.6815 94.1547 10.3901C94.7985 10.0987 95.2695 9.67515 95.5676 9.11946C95.8658 8.56376 96.0149 7.89625 96.0149 7.11692C96.0149 6.33082 95.8624 5.64975 95.5575 5.07373C95.2593 4.4977 94.7883 4.05721 94.1445 3.75226C93.5075 3.44053 92.6706 3.28466 91.6337 3.28466H87.6896V21.4091H84.5486ZM94.8256 12.0165L99.9691 21.4091H96.391L91.3491 12.0165H94.8256Z" fill="currentColor" /><path d="M100.136 0.590899H103.948L110.575 16.7738H110.819L117.447 0.590899H121.259V21.4091H118.27V6.34437H118.077L111.938 21.3786H109.457L103.318 6.33421H103.124V21.4091H100.136V0.590899Z" fill="currentColor" /><path d="M124.722 21.4091H121.388L128.879 0.590899H132.508L140 21.4091H136.666L130.78 4.37233H130.618L124.722 21.4091ZM125.281 13.2567H136.097V15.8996H125.281V13.2567Z" fill="currentColor" /></svg></a>
    <nav class="header-nav" aria-label="Primary">
      <ul>
        {
          navLinks.slice(0, 4).map((link) => (
            <li>
              <a href={link.href} aria-label={link.label.toLowerCase().replace(' ', '-')}>
                <span class="swap">
                  <span>{link.label}</span>
                  <span aria-hidden="true">{link.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/contact" aria-label="contact" class={contactClass}>
      <span class="swap">
        <span>Contact</span>
        <span aria-hidden="true">Contact</span>
      </span>
    </a>
    <div class="burger tablet-only">
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false" data-burger>
        <span class="burger-lines" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>
</div>
<div class="header-blur-background hidden" data-menu-blur aria-hidden="true"></div>
  <div class="mobile-menu" data-mobile-menu role="dialog" aria-modal="true" aria-label="Menu">
    <button class="burger" type="button" aria-label="Close menu" data-menu-close>
      <span class="burger-lines" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
    <nav aria-label="Mobile">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>
                <span class="swap">
                  <span>{link.label}</span>
                  <span aria-hidden="true">{link.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/contact" aria-label="contact" class="button-white">
      <span class="swap">
        <span>Contact</span>
        <span aria-hidden="true">Contact</span>
      </span>
    </a>
  </div>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--white);
    min-height: 44px;
  }

  .logo svg {
    display: block;
    width: 140px;
    height: 22px;
  }

  .header-light .logo,
  .header-light .header-nav a,
  .header-light .burger {
    color: var(--black);
  }

  .desktop-only {
    display: inline-flex;
  }

  .tablet-only {
    display: none;
  }

  .header-blur-background {
    position: fixed;
    inset: 0;
    background: rgba(13, 11, 11, 0.5);
    z-index: 40;
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--black);
    color: var(--white);
    padding: 1.25rem var(--container-px-mobile);
    flex-direction: column;
    gap: 2rem;
  }

  .mobile-menu.open {
    display: flex;
  }

  .mobile-menu .burger {
    display: block;
    align-self: flex-start;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.5rem;
  }

  .mobile-menu a {
    text-decoration: none;
    color: inherit;
  }

  .mobile-menu .button-white {
    color: var(--black);
  }

  .mobile-menu .button-white:hover {
    color: var(--white);
  }

  @media (max-width: 991px) {
    .header-nav,
    .desktop-only {
      display: none;
    }

    .tablet-only {
      display: block;
    }

    .tablet-only .burger {
      display: block;
    }
  }
</style>
