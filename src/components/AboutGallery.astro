---
import { gallerySlides } from '../content/landing';

const tones = ['red', 'dark-red', 'burgundi-red'];
---

<section class="section about" aria-label="About ProForma">
  {
    gallerySlides.map((slide, i) => (
      <div class="gallery-item">
        <div class="gallery-item-sticky">
          <div class="gallery-item-inner mobile-flex">
            <div class="gallery-media">
              <img
                class={`gallery-item-media-rules${i === gallerySlides.length - 1 ? ' last-item-media' : ''}`}
                src={slide.image}
                alt={slide.alt}
                width={slide.width}
                loading="lazy"
              />
            </div>
            <div class="gallery-item-content-wrapper-rules">
              <div class={`card-slide ${tones[i]}`}>
                <div class="slide-content slide-content-flex-left">
                  <div class="heading reveal">
                    <div class="text-white">
                      <h2>{slide.heading}</h2>
                    </div>
                  </div>
                  <img
                    class={`gallery-item-media-rules desktop-hidden reveal${i === gallerySlides.length - 1 ? ' last-item-media' : ''}`}
                    src={slide.image}
                    alt={slide.mobileAlt}
                    loading="lazy"
                  />
                  <div class="flex-text-wrapper reveal">
                    <div class="text-white">
                      <p class="heading-s">{slide.subheading}</p>
                    </div>
                    <div class="text-white-80">
                      <p class="text-s">{slide.body}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        {
          i < gallerySlides.length - 1 && (
            <div class="gallery-scroll-distance" aria-hidden="true"></div>
          )
        }
      </div>
    ))
  }
</section>

<style>
  .about {
    padding-top: 0;
    padding-bottom: 0;
    overflow: clip;
  }

  .gallery-scroll-distance {
    height: 100svh;
  }

  .gallery-item + .gallery-item {
    margin-top: -100svh;
  }

  .gallery-item-sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .gallery-item-inner {
    display: flex;
    flex-direction: row-reverse;
    height: 100svh;
  }

  .gallery-item-content-wrapper-rules {
    flex: 0 0 50%;
    display: flex;
    min-width: 0;
  }

  .card-slide {
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .card-slide.red {
    background: var(--accent);
  }

  .card-slide.dark-red {
    background: var(--dark-red);
  }

  .card-slide.burgundi-red {
    background: var(--burgundi);
  }

  .slide-content-flex-left {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 5rem 8.125rem 5rem 4.375rem;
    min-width: 0;
  }

  .text-white {
    color: var(--white);
  }

  .text-white-80 {
    color: rgba(255, 255, 255, 0.8);
  }

  .heading h2 {
    margin: 0;
  }

  .flex-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .flex-text-wrapper p {
    margin: 0;
  }

  .gallery-media {
    flex: 0 0 50%;
    position: relative;
    min-width: 0;
  }

  .gallery-item-media-rules {
    object-fit: cover;
    display: block;
  }

  .gallery-media .gallery-item-media-rules {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 55vw;
    height: 110svh;
    max-width: none;
  }

  .gallery-item-media-rules.desktop-hidden {
    display: none;
  }

  @media (max-width: 991px) {
    .gallery-item-inner.mobile-flex {
      display: block;
      height: auto;
    }

    .gallery-item-sticky {
      height: auto;
      min-height: 100svh;
    }

    .gallery-item-content-wrapper-rules {
      display: block;
    }

    .gallery-media .gallery-item-media-rules:not(.desktop-hidden) {
      display: none;
    }

    .gallery-item-media-rules.desktop-hidden {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }

    .slide-content-flex-left {
      padding: 5rem 2rem;
      gap: 2rem;
    }
  }

  @media (max-width: 767px) {
    .gallery-item-sticky {
      position: static;
      min-height: 0;
    }

    .gallery-scroll-distance {
      display: none;
    }

    .slide-content-flex-left {
      padding: 6rem 2rem;
      gap: 1.5rem;
    }
  }

  @media (max-width: 479px) {
    .slide-content-flex-left {
      padding: 6rem 1.25rem;
    }
  }
</style>
