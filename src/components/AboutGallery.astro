---
import { gallerySlides } from '../content/landing';

const tones = ['red', 'dark-red', 'burgundi-red'];
---

<section class="section about" aria-label="About ProForma">
  <div class="gallery-scroll-distance" aria-hidden="true"></div>
  {
    gallerySlides.map((slide, i) => (
      <div class="gallery-item">
        <div class="gallery-item-sticky">
          <div
            class="gallery-item-inner mobile-flex"
            style={`--media-max: ${slide.width}px`}
          >
            <img
              class={`gallery-item-media-rules${i === gallerySlides.length - 1 ? ' last-item-media' : ''}`}
              src={slide.image}
              alt={slide.alt}
              width={slide.width}
              loading="lazy"
            />
            <div class="gallery-item-content-wrapper-rules">
              <div class={`card-slide ${tones[i]}`}>
                <div class="slide-content slide-content-flex-left">
                  <div class="heading reveal">
                    <div class="text-white">
                      <h2>{slide.heading}</h2>
                    </div>
                  </div>
                  <img
                    class={`gallery-item-media-rules desktop-hidden reveal${i === gallerySlides.length - 1 ? ' last-item-media' : ''}`}
                    src={slide.image}
                    alt={slide.mobileAlt}
                    loading="lazy"
                  />
                  <div class="flex-text-wrapper reveal">
                    <div class="text-white">
                      <p class="heading-s">{slide.subheading}</p>
                    </div>
                    <div class="text-white-80">
                      <p class="text-s">{slide.body}</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="gallery-scroll-distance" aria-hidden="true"></div>
      </div>
    ))
  }
</section>

<style>
  .about {
    padding-top: 0;
    padding-bottom: 0;
  }

  .gallery-scroll-distance {
    height: 20vh;
  }

  .gallery-item-sticky {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .gallery-item-inner {
    display: grid;
    grid-template-columns: minmax(0, var(--media-max, 40rem)) minmax(0, 1fr);
    width: 100%;
    min-height: 100svh;
  }

  .gallery-item-media-rules {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-item-media-rules.desktop-hidden {
    display: none;
  }

  .gallery-item-content-wrapper-rules {
    display: flex;
    min-width: 0;
  }

  .card-slide {
    display: flex;
    flex: 1;
    min-width: 0;
  }

  .card-slide.red {
    background: var(--accent);
  }

  .card-slide.dark-red {
    background: var(--dark-red);
  }

  .card-slide.burgundi-red {
    background: var(--burgundi);
  }

  .slide-content-flex-left {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 4rem;
    min-width: 0;
  }

  .text-white {
    color: var(--white);
  }

  .text-white-80 {
    color: rgba(255, 255, 255, 0.8);
  }

  .heading h2 {
    margin: 0;
  }

  .flex-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .flex-text-wrapper p {
    margin: 0;
  }

  @media (max-width: 991px) {
    .gallery-item-inner {
      grid-template-columns: 1fr 1fr;
    }

    .slide-content-flex-left {
      padding: 3rem;
      gap: 2rem;
    }
  }

  @media (max-width: 767px) {
    .gallery-item-inner.mobile-flex {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .gallery-item-sticky {
      min-height: 0;
    }

    .gallery-item-media-rules:not(.desktop-hidden) {
      display: none;
    }

    .gallery-item-media-rules.desktop-hidden {
      display: block;
      width: 100%;
      height: auto;
    }

    .slide-content-flex-left {
      padding: 2.5rem 1.25rem;
      gap: 1.5rem;
    }

    .about h2 {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 479px) {
    .slide-content-flex-left {
      padding: 2rem 1.25rem;
    }
  }
</style>
