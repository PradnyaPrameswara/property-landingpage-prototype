---
import { hero } from '../content/landing';

const words = hero.title.split(' ');
---

<section class="section hero-section" id="hero">
  <div class="bg-about-us" aria-hidden="true"></div>
  <div class="container">
    <div class="hero-wrapper">
      <div class="hero-left-content">
        <h1 aria-label={hero.title}>
          {
            words.map((word, i) => (
              <span class="hero-word reveal" style={`transition-delay:${i * 120}ms`} aria-hidden="true">
                {word}
                {i < words.length - 1 ? ' ' : ''}
              </span>
            ))
          }
        </h1>
        <div class="text-m reveal" style="transition-delay:240ms">{hero.body}</div>
        <div class="button-wrapper reveal" style="transition-delay:360ms">
          <a class="button-white button-white-grey-hover" href={hero.ctaHref} aria-label="contact">
            <span class="swap">
              <span>{hero.ctaLabel}</span>
              <span aria-hidden="true">{hero.ctaLabel}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    color: var(--white);
    padding-top: 6.1rem;
    min-height: 100svh;
    display: flex;
    align-items: stretch;
  }

  .bg-about-us {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/images/687de0372adef1af8e3e9473_main-transform.webp');
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .hero-section .container {
    position: relative;
    z-index: 1;
    display: flex;
  }

  .hero-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
  }

  .hero-left-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2.5rem;
    padding-bottom: 4rem;
  }

  @media (max-width: 767px) {
    .hero-wrapper {
      grid-template-columns: 1fr;
    }
  }

  .hero-left-content .text-m {
    max-width: 36rem;
    color: var(--gray-100);
  }
</style>
