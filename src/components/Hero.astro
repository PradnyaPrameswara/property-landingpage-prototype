---
import { hero } from '../content/landing';
---

<section class="section hero-section" id="hero">
  <div class="container">
    <div class="hero-wrapper">
      <div class="hero-left-content">
        <h1 class="reveal">{hero.title}</h1>
        <div class="max-width-text-wrapper reveal" style="transition-delay:120ms">
          <div class="text-m">{hero.body}</div>
        </div>
        <div class="button-wrapper reveal" style="transition-delay:240ms">
          <a class="button-white-grey-hover" href={hero.ctaHref} aria-label="contact">
            <span class="swap">
              <span>{hero.ctaLabel}</span>
              <span aria-hidden="true">{hero.ctaLabel}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-about-us" aria-hidden="true"></div>
</section>

<style>
  .hero-section {
    color: var(--white);
    padding-top: 10rem;
    padding-bottom: 7.5rem;
    min-height: 90svh;
    display: flex;
    align-items: stretch;
  }

  .bg-about-us {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: url('/images/687de0372adef1af8e3e9473_main-transform.webp');
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: cover;
    transform: translateY(-2.74%) scale(1.1);
  }

  .hero-section .container {
    position: relative;
    z-index: 1;
    display: flex;
  }

  .hero-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    width: 100%;
  }

  .hero-left-content {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 2.5rem;
    padding-bottom: 0;
  }

  .hero-left-content .text-m {
    max-width: 28.6875rem;
    color: var(--white);
    font-family: var(--font-display);
  }

  .hero-left-content .button-white-grey-hover {
    font-family: var(--font-display);
    line-height: 1.2;
    letter-spacing: normal;
    border: 0;
    padding: 0.95rem 1.75rem 1rem;
  }

  @media (min-width: 768px) and (max-width: 991px) {
    .hero-section {
      min-height: 100svh;
      padding-top: 5rem;
      padding-bottom: 5rem;
    }

    .hero-section .container {
      padding-inline: 1.25rem;
    }

    .hero-wrapper {
      grid-template-columns: 1fr;
    }

    .hero-left-content {
      width: min(31.52rem, 100%);
    }
  }

  @media (max-width: 767px) {
    .hero-section {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }

    .hero-wrapper {
      grid-template-columns: 1fr;
    }

    .bg-about-us {
      height: 100svh;
      background-size: auto 100%;
    }
  }
</style>
