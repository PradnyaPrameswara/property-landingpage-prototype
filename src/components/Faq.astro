---
import { faq } from '../content/landing';
---

<section class="section section-long-top-padding">
  <div class="container-vertical-flex">
    <div class="container">
      <h2 class="heading reveal">Frequently asked questions</h2>
    </div>
    <div class="faq-wrapper">
      {
        faq.map((item, i) => (
          <details class={`faq${i === 0 ? ' top-line' : ''}`} name="proforma-faq">
            <summary>
              <div class="container">
                <span class="dropdown-content-wrapper">
                  <span class="heading-s">{item.question}</span>
                  <span class="plus" aria-hidden="true"></span>
                </span>
              </div>
            </summary>
            <div class="faq-body">
              <div class="container">
                <p>{item.answer}</p>
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .container-vertical-flex {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .faq-wrapper {
    width: 100%;
  }

  .faq summary {
    display: block;
    padding: 0;
  }

  .dropdown-content-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0;
    min-height: 44px;
  }
</style>
