---
import Base from '../layouts/Base.astro';
---

<Base title="Not Found | ProForma" description="The page you are looking for does not exist.">
  <section class="section section-margin">
    <div class="container not-found">
      <h1 class="reveal">Page not found</h1>
      <div class="text-s reveal">The page you are looking for does not exist or has moved.</div>
      <div class="reveal">
        <a class="button-white" href="/" aria-label="Back home">
          <span class="swap">
            <span>Back home</span>
            <span aria-hidden="true">Back home</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-margin {
    padding-top: 9rem;
    min-height: 70svh;
  }

  .not-found {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
</style>
