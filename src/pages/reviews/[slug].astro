---
import Base from '../../layouts/Base.astro';
import { reviewsListA, reviewsListB, reviewStars } from '../../content/landing';

export function getStaticPaths() {
  const seen = new Set<string>();
  const all = [...reviewsListA, ...reviewsListB].filter((review) => {
    const slug = review.href.replace('/reviews/', '');
    if (seen.has(slug)) return false;
    seen.add(slug);
    return true;
  });
  return all.map((review) => ({
    params: { slug: review.href.replace('/reviews/', '') },
    props: { review },
  }));
}

const { review } = Astro.props;
const title = review.href.replace('/reviews/', '').replace(/-/g, ' ');
---

<Base title={`${title} | ProForma`} description={review.quote} header="light">
  <section class="section section-margin">
    <div class="container content-vertical">
      <h1 class="reveal">{title}</h1>
      <div class="review-card reveal">
        <div>
          <img src={reviewStars} alt="" loading="lazy" />
        </div>
        <div class="grey-content">
          <div class="text-s">{review.quote}</div>
        </div>
        <div class="text-s">{review.author}</div>
      </div>
      <div class="reveal">
        <a class="button-white" href="/" aria-label="Back home">
          <span class="swap">
            <span>Back home</span>
            <span aria-hidden="true">Back home</span>
          </span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-margin {
    padding-top: 16.88rem;
    min-height: 70svh;
  }

  .content-vertical {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 48rem;
  }

  .content-vertical h1 {
    text-transform: capitalize;
  }

  .review-card {
    background: var(--gray-50);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>

