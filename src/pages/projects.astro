---
import Base from '../layouts/Base.astro';
import CTASection from '../components/CTASection.astro';
import { projectDetails } from '../content/generated';

const filters = ['All', ...Array.from(new Set(projectDetails.map((p) => p.service).filter(Boolean)))];
---

<Base
  title="Projects | ProForma"
  description="Discover ProForma's extensive project gallery. Browse our architecture, interior design, renovation, and exterior projects."
>
  <section class="section section-margin" id="hero">
    <div class="container">
      <h1 class="reveal">Projects</h1>
      <div class="tabs" role="group" aria-label="Filter projects by service" data-tabs>
        {
          filters.map((filter, i) => (
            <button
              type="button"
              class="tab-button"
              data-filter={filter}
              data-active={i === 0 ? 'true' : 'false'}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {filter}
            </button>
          ))
        }
      </div>
      <div class="projects-list" data-grid>
        {
          projectDetails.map((project) => (
            <div class="projects-item reveal" data-service={project.service}>
              <a class="project-card" href={`/project/${project.slug}`} aria-label={project.h1}>
                <span class="projects-image-wrapper">
                  <img class="image-full-width" src={project.cover} alt="" loading="lazy" />
                </span>
                <span class="projects-text-wrapper">
                  <span class="heading-s">{project.h1}</span>
                  <span class="grey-content">
                    <span class="text-s">{project.service}</span>
                  </span>
                </span>
              </a>
            </div>
          ))
        }
      </div>
      <p class="empty-note text-s" data-empty hidden>No projects found for this service.</p>
    </div>
  </section>

  <CTASection />
</Base>

<script>
  const tabs = document.querySelector('[data-tabs]');
  const grid = document.querySelector('[data-grid]');
  const empty = document.querySelector('[data-empty]');

  tabs?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('[data-filter]');
    if (!(button instanceof HTMLButtonElement) || !grid) return;
    const filter = button.dataset.filter ?? 'All';
    tabs.querySelectorAll('[data-filter]').forEach((el) => {
      const active = el === button;
      el.setAttribute('data-active', String(active));
      el.setAttribute('aria-pressed', String(active));
    });
    let visible = 0;
    grid.querySelectorAll('[data-service]').forEach((card) => {
      const show = filter === 'All' || (card as HTMLElement).dataset.service === filter;
      (card as HTMLElement).hidden = !show;
      if (show) visible += 1;
    });
    if (empty instanceof HTMLElement) empty.hidden = visible > 0;
  });
</script>

<style>
  .section-margin {
    padding-top: 9rem;
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 2rem 0;
  }

  .tab-button {
    border: 1px solid var(--black);
    border-radius: 6.25rem;
    background: transparent;
    padding: 0.75rem 1.5rem;
    min-height: 44px;
    cursor: pointer;
    font-size: 1rem;
  }

  .tab-button[data-active='true'] {
    background: var(--black);
    color: var(--white);
  }

  .projects-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .image-full-width {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .projects-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .empty-note {
    color: var(--gray-300);
    margin-top: 2rem;
  }

  @media (max-width: 991px) {
    .projects-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .projects-list {
      grid-template-columns: 1fr;
    }
  }
</style>
