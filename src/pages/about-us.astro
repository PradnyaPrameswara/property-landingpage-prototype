---
import Base from '../layouts/Base.astro';
import TeamGrid from '../components/TeamGrid.astro';
import Faq from '../components/Faq.astro';
import CTASection from '../components/CTASection.astro';
import { aboutIntro, aboutHelps } from '../content/landing';
---

<Base
  title="About us | ProForma"
  description="Explore ProForma's About Us page: discover our company philosophy, benefits of expert consultations, customization, and quality assurance."
>
  <section class="section hero-section" id="hero">
    <div class="bg-about" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-wrapper">
        <div class="hero-left-content">
          <h1 class="reveal">{aboutIntro.title}</h1>
          <div class="text-m reveal">{aboutIntro.body}</div>
          <div class="button-wrapper reveal">
            <a class="button-white button-white-grey-hover" href={aboutIntro.ctaHref} aria-label="contact">
              <span class="swap">
                <span>{aboutIntro.ctaLabel}</span>
                <span aria-hidden="true">{aboutIntro.ctaLabel}</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-long-padding">
    <div class="container">
      <h2 class="reveal">How we help</h2>
      <div class="help-grid">
        {
          aboutHelps.map((item) => (
            <div class="column-card-advant column-card-advant-white reveal">
              <div class="column-card-advant-top">
                <div class="circle-grey">
                  <div class="text-numbers">{item.number}</div>
                </div>
                <div class="column-card-advant-header">
                  <div class="heading-s">{item.title}</div>
                </div>
              </div>
              <div class="column-card-advant-bottom">
                <div class="text-s">{item.body}</div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <TeamGrid />
  <Faq />
  <CTASection />
</Base>

<style>
  .hero-section {
    color: var(--white);
    padding-top: 6.1rem;
    min-height: 100svh;
    display: flex;
    align-items: center;
  }

  .bg-about {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to bottom, var(--black-light-50), var(--black-light-50)),
      url('/images/6870b759eca23be9cef0f716_about.webp');
    background-position: 0 0, 50%;
    background-repeat: repeat, no-repeat;
    background-size: auto, cover;
  }

  .hero-section .container {
    position: relative;
    z-index: 1;
  }

  .hero-wrapper {
    max-width: 60rem;
  }

  .hero-left-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-left-content .text-m {
    max-width: 36rem;
    color: var(--gray-100);
  }

  .help-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .column-card-advant-white {
    background: var(--gray-50);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .column-card-advant-top {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .circle-grey {
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    border: 1px solid var(--black);
    display: grid;
    place-items: center;
  }

  @media (max-width: 767px) {
    .help-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
