---
import Base from '../layouts/Base.astro';
import CTASection from '../components/CTASection.astro';
import { contactIntro, contactCards, footerSocials } from '../content/landing';
---

<Base
  title="Contact | ProForma"
  description="Need an architectural or design project? Contact ProForma by phone, email, or social media."
>
  <section class="section section-margin section-long-bottom" id="hero">
    <div class="container">
      <h1 class="reveal">{contactIntro.title}</h1>
      <div class="contact-card-wrapper">
        {
          contactCards.map((card) => (
            <div class="contact-card reveal">
              <div class="heading-s">{card.title}</div>
              {card.title === 'Contact' ? (
                <div class="contact-links">
                  {(card.links ?? []).map((link) => (
                    <a class="text-inner-link" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : card.title === 'Social' ? (
                <div class="contact-links">
                  {footerSocials.map((link) => (
                    <a class="text-inner-link" href={link.href} target="_blank" rel="noreferrer">
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : (
                <div class="contact-lines">
                  {card.lines.map((line) => (
                    <div class="text-s">{line}</div>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTASection />
</Base>

<style>
  .section-margin {
    padding-top: 16.88rem;
  }

  .contact-card-wrapper {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .contact-card {
    background: var(--white);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 5rem;
  }

  .contact-links,
  .contact-lines {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .text-inner-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 767px) {
    .contact-card-wrapper {
      grid-template-columns: 1fr;
    }
  }
</style>

