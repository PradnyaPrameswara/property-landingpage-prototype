---
import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';
import CTASection from '../../components/CTASection.astro';
import { projectDetails } from '../../content/generated';

export function getStaticPaths() {
  return projectDetails.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const related = projectDetails.filter((p) => p.slug !== project.slug && p.service === project.service);
const fallback = projectDetails.filter((p) => p.slug !== project.slug && p.service !== project.service);
const relatedShown = [...related, ...fallback].slice(0, 3);
const metaRows: Array<[string, string]> = [
  ['Client', project.client],
  ['Budget', project.budget],
  ['Date', project.date],
  ['Location', project.location],
  ['Service', project.service],
];
---

<Base title={`Projects | ${project.h1} | ProForma`} description={project.description}>
  <section class="section hero-section" id="hero">
    <div class="container">
      <div class="hero-wrapper hero-wrapper-flex">
        <div class="hero-wrapper-heading">
          <h1 class="reveal">{project.h1}</h1>
        </div>
        <div class="max-width-text-wrapper reveal">
          <div class="text-white">
            <div class="text-m">{project.description}</div>
          </div>
        </div>
      </div>
    </div>
    <div class="bg-project" aria-hidden="true" style={`background-image:url("${project.cover}")`}>
      <div class="bg-black-light-50" aria-hidden="true"></div>
    </div>
  </section>

  <section class="section section-visible">
    <div class="container">
      <h2 class="reveal">About object</h2>
      <div class="blog-post-grid">
        <div class="sticky-content">
          <div class="meta-side">
            {
              metaRows.map(([label, value]) => (
                <div class="meta-row">
                  <div class="text-s">{label}</div>
                  <div class="text-m">{value}</div>
                </div>
              ))
            }
          </div>
        </div>
        <div class="richtext reveal" set:html={project.body} />
      </div>
    </div>
  </section>

  <section class="section section-long-bottom-pading no-top-mobile-padding">
    <div class="container">
      <div class="heading-wrapper-bottom-padding">
        <h2 class="reveal">Our projects</h2>
      </div>
      <div class="blog-content">
        <div class="blog-content-card">
          <div class="related-grid">
            {
              relatedShown.map((item) => (
                <a class="project-card" href={`/project/${item.slug}`} aria-label={item.h1}>
                  <span class="projects-image-wrapper">
                    <img class="image-full-width" src={item.cover} alt="" loading="lazy" />
                  </span>
                  <span class="projects-text-wrapper">
                    <span class="heading-s">{item.h1}</span>
                    <span class="grey-content">
                      <span class="text-s">{item.service}</span>
                    </span>
                  </span>
                </a>
              ))
            }
          </div>
          <div class="button-wrapper-center">
            <a class="button-white" href="/projects" aria-label="button">
              <span class="swap">
                <span>Go to projects</span>
                <span aria-hidden="true">Go to projects</span>
              </span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Faq sectionClass="section no-top-padding" />
  <CTASection />
</Base>

<style>
  .hero-section {
    color: var(--white);
    padding-top: 16.88rem;
    padding-bottom: var(--section-py);
    min-height: 100svh;
    display: flex;
    align-items: stretch;
  }

  .bg-project {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-position: 50%;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .bg-black-light-50 {
    position: absolute;
    inset: 0;
    background: var(--black-light-50);
  }

  .hero-section .container {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
  }

  .hero-wrapper-flex {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    max-width: 60rem;
  }

  .text-white {
    color: var(--white);
  }

  .hero-section .text-m {
    color: var(--gray-100);
  }

  .section-visible {
    padding-top: var(--section-py);
    padding-bottom: var(--section-py);
  }

  .blog-post-grid {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: 3rem;
    margin-top: 2.5rem;
    align-items: start;
  }

  .sticky-content {
    position: sticky;
    top: 6rem;
  }

  .meta-side {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--gray-100);
  }

  .meta-row {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--gray-100);
  }

  .meta-row .text-s {
    color: var(--gray-300);
  }

  .heading-wrapper-bottom-padding {
    padding-bottom: 2.5rem;
  }

  .blog-content-card {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .project-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .image-full-width {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .projects-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .button-wrapper-center {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 991px) {
    .blog-post-grid {
      grid-template-columns: 1fr;
    }

    .sticky-content {
      position: static;
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 767px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
