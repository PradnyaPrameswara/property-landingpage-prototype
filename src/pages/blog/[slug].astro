---
import Base from '../../layouts/Base.astro';
import CTASection from '../../components/CTASection.astro';
import { blogDetails } from '../../content/generated';
import { blogPosts } from '../../content/landing';

export function getStaticPaths() {
  return blogDetails.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const meta = blogPosts.find((p) => p.slug === post.slug);
const related = blogDetails.filter((p) => p.slug !== post.slug).slice(0, 3);
---

<Base title={`Blogs | ${post.h1} | ProForma`} description={post.description}>
  <section class="section section-margin" id="hero">
    <div class="container">
      <nav class="breadcrumb text-s" aria-label="Breadcrumb">
        <a href="/blog">Blog</a>
        <span aria-hidden="true"> / </span>
        <span aria-current="page">{post.h1}</span>
      </nav>
      <h1 class="reveal">{post.h1}</h1>
      <div class="author-flex-block reveal">
        {
          post.authorPhoto && (
            <span class="image-author-wrapper">
              <img class="author-photo" src={post.authorPhoto} alt="" loading="lazy" />
            </span>
          )
        }
        <div class="author-flex-wrapper">
          <div class="text-m">{post.author}</div>
          <div class="text-s">{meta?.date ?? ''}</div>
        </div>
      </div>
      <img class="detail-cover reveal" src={post.cover} alt="" loading="eager" />
      <div class="richtext reveal" set:html={post.body} />
      <div class="author-box">
        <div class="text-m">{post.author}</div>
        <div class="text-s">{meta?.date ?? ''}</div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="reveal">Latest articles</h2>
      <div class="related-grid">
        {
          related.map((item) => {
            const itemMeta = blogPosts.find((p) => p.slug === item.slug);
            return (
              <a class="blog-post-card" href={`/blog/${item.slug}`} aria-label="blog posts">
                <span class="blog-post-image-wrapper">
                  <img class="image-full-width" src={item.cover} alt="" loading="lazy" />
                </span>
                <span class="blog-posts-text-wrapper">
                  <span class="grey-content">
                    <span class="text-s">{itemMeta?.date ?? ''}</span>
                  </span>
                  <span class="heading-s">{item.h1}</span>
                </span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <CTASection />
</Base>

<style>
  .section-margin {
    padding-top: 9rem;
  }

  .breadcrumb {
    margin-bottom: 1rem;
  }

  .breadcrumb a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .author-flex-block {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  .author-photo {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .detail-cover {
    margin: 1rem 0 2.5rem;
  }

  .author-box {
    margin-top: 3rem;
    padding: 2rem;
    background: var(--gray-50);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }

  .blog-post-card {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .image-full-width {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .blog-posts-text-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (max-width: 767px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
