{
  "name": "property-landingpage-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit",
    "guard": "powershell -NoProfile -Command \"rg -n 'useEffect|useLayoutEffect|@radix-ui|jquery|webflow\\.schunk|data-w-id' src; if ($?) { exit 1 }\""
  },
  "dependencies": {
    "astro": "^4.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^3.6.2",
    "@astrojs/tailwind": "^5.1.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  }
}
